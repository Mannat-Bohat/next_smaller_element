#include <iostream>
#include <vector>
#include <stack>
#include <climits>
#include <algorithm>

using namespace std;
vector<int> nextSmallerElement(vector<int> &arr, int n)
{
    stack<int> s;
    s.push(-1);
    
    // Initializing the vector with size 'n' to avoid segmentation fault/runtime errors
    vector<int> ans(n); 
    
    for(int i = n - 1; i >= 0; i--) {
        int curr = arr[i];

        // Pop elements from stack until a smaller element is found
        while(s.top() >= curr)
        {
            s.pop();
        }
        
        // ans is stack ka top
        ans[i] = s.top();
        
        // Push the current element value into the stack
        s.push(curr);
    }
    return ans;
}

int main() {
    vector<int> arr = {2, 3, 11};
    int n = arr.size();
    
    vector<int> result = nextSmallerElement(arr, n);
    
    cout << "Next Smaller Elements: ";
    for(int val : result) {
        cout << val << " ";
    }
    cout << endl;
    
    return 0;
}
